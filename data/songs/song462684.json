  "lyrics_raw": [
    "甘あまくて幸しあわせなこと",
    "隠かくし味何あじなににしよう",
    "純粋じゅんすいな乙女心おとめごころ",
    "甘あまい恋こいも絡からめなくちゃ",
    "切せつなさ重かさねてミルフィーユ",
    "酸味さんみも積つみ上あげタルト",
    "苦味にがみもチョコレートケーキ?",
    "魔法まほうかけた甘あまい奇跡きせき",
    "甘あまさを抑おさえてビターとか",
    "ミルクなしのコーヒーとか",
    "甘あまいだけじゃ大人おとなになれないの?",
    "そんなの絶対ぜったいに絶対ぜったいやだやだやだ",
    "ねぇあげようか 甘あまい罠わな",
    "ほら虜とりこにしてあげる",
    "そんな魔法まほう かけるから",
    "ちょっとだけ待またせたげるわ",
    "たった一口ひとくちが足たりなくて",
    "赤あかいイチゴみたく意地張いじはって",
    "甘あまいところなんて見みせないわ",
    "完璧かんぺきに作つくるもん",
    "一人ひとりでも、でも、でも",
    "ねぇ、気きづいてるんでしょ?",
    "わかってるんでしょ?",
    "隠かくし味あじの恋心こいごころ",
    "苦にがみとか酸味さんみとか",
    "そういうのもたまにはいいわ",
    "意地いじっ張ぱりでワガママな",
    "そんな「甘あまい魔法まほう」使つかい"
  ],
