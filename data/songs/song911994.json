  "lyrics_raw": [
    "ヘッドホン外はずして",
    "一人ひとりきり 歩あるく街まち",
    "迷まよっているのか",
    "間違まちがっているのか",
    "知しらない場所ばしょみたいだ",
    "見みえない信仰心しんこうしん",
    "感かんじないシンパシー",
    "俺おれにはないものばかりだ",
    "なんのストーリー?",
    "だれのストーリー?",
    "手てに入はいんなきゃ欲ほしくなる",
    "そうだろ",
    "合図あいずくれよ",
    "マイクかざせ",
    "あいつは今いま",
    "追おい風かぜになびいていく",
    "チャンスはきた",
    "ダイブすんぜHATER!",
    "今いまリスタートキメて はじめて",
    "\"みたい\"ただそれだけでいいでしょ",
    "理由りゆうなんて知しらない",
    "理由りゆうなんていらない",
    "運命うんめい ルールに抗あらがって",
    "今いまリスタートキメて 弾はじけて",
    "\"見みたい\"ただそれだけでいいでしょ",
    "打うち鳴ならせGroovy",
    "聴きかせてよHeart Beat",
    "立たち止どまる暇ひまなんてないから",
    "Hey Yo!",
    "アーアーマイクチェックワンツー",
    "All Nightでも案外あんがい余裕よゆう～",
    "とか言いうお前まえマジで女優じょゆう(笑わら)",
    "上流じょうりゅう階級かいきゅう?なら物申ものもうす!",
    "RADでBADなUNDER DOGが",
    "ビビッときたね VIVIDに染そまれ",
    "上うえしかみてねえ",
    "今日きょうのオマエは",
    "秘ひめる闘志とうしの悩なやめる勝かち犬いぬ",
    "合図あいずくれよ",
    "マイクかざせ",
    "俺おれらは今いま",
    "追おい風かぜになびいていく",
    "チャンスはきた",
    "ダイブすんぜHATER!",
    "今いまリスタートキメて はじめて",
    "\"みたい\"ただそれだけでいいでしょ",
    "理由りゆうなんて知しらない",
    "理由りゆうなんていらない",
    "背徳はいとくの快感かいかん 味あじわって",
    "今いまリスタートキメて 弾はじけて",
    "\"見みたい\"ただそれだけでいいでしょ",
    "打うち鳴ならせGroovy",
    "聴きかせてよHeart Beat",
    "立たち止どまる暇ひまなんてないから",
    "追おい風かぜに吹ふかれて",
    "Alright 振ふり向むかず",
    "進すすんで"
  ],
